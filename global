:root {
  --bg: #fdf6ee;
  --text: #3b2a20;
  --muted: #7a6355;
  --accent: #d9734e;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1f1915;
    --text: #f5ebe0;
    --muted: #bfa996;
    --accent: #f0956f;
  }
}

* {
  box-sizing: border-box;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 720px;
  margin: 0 auto;
  padding: 64px 24px;
}

.eyebrow {
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

h1 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.25rem, 6vw, 3.75rem);
  line-height: 1.1;
  margin-bottom: 24px;
}

.description {
  color: var(--muted);
  font-size: 1.2rem;
  max-width: 60ch;
}

.footer {
  text-align: center;
  padding: 24px;
  color: var(--muted);
  font-size: 0.9rem;
}
